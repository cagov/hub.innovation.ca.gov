{#- Styleguide color swatches. `sets` is one group from styleguideColors.json:
    [{ title, swatches: [{ name, hex, rgb, note }] }]. Copy buttons are wired up
    by docs/src/js/copy-value.js, which writes to the page's .sg-copy-status. -#}
{% macro copyIcon() -%}
<svg class="sg-copy__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9 18q-.825 0-1.412-.587T7 16V4q0-.825.588-1.412T9 2h9q.825 0 1.413.588T20 4v12q0 .825-.587 1.413T18 18zm0-2h9V4H9zm-4 6q-.825 0-1.412-.587T3 20V7q0-.425.288-.712T4 6t.713.288T5 7v13h10q.425 0 .713.288T16 21t-.288.713T15 22z"/></svg>
{%- endmacro %}

{% macro swatches(sets) %}
{%- for set in sets %}
<div class="sg-swatch-set">
  {%- if set.title %}<p class="sg-swatch-set__title">{{ set.title }}</p>{% endif %}
  <ul class="sg-swatches" role="list">
    {%- for s in set.swatches %}
    <li class="sg-swatch sg-swatch--{{ s.hex | swatchText }}" data-hex="{{ s.hex }}">
      <div class="sg-swatch__color" style="background-color: {{ s.hex }}">
        <p class="sg-swatch__label">{% if s.name %}<span class="sg-swatch__name">{{ s.name }}</span>{% endif %}<span class="sg-swatch__hex">{{ s.hex }}</span></p>
        <button type="button" class="sg-copy" data-copy="{{ s.hex }}" aria-label="Copy hex">{{ copyIcon() | safe }}</button>
      </div>
      {%- if s.rgb %}
      <div class="sg-swatch__field">
        <code class="sg-swatch__rgb">{{ s.rgb }}</code>
        <button type="button" class="sg-copy" data-copy="{{ s.rgb }}" aria-label="Copy RGB">{{ copyIcon() | safe }}</button>
      </div>
      {%- endif %}
      {%- if s.note %}<p class="sg-swatch__note">{{ s.note }}</p>{% endif %}
    </li>
    {%- endfor %}
  </ul>
</div>
{%- endfor %}
{% endmacro %}
